# Isolated Container Test Environment for Experienced LLMs
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root

# Install runtime dependencies (build tools, git, cron, curl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    cron \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain for Rust engine tests
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /workspace
COPY . /workspace

# Verify line endings and execute full lifecycle
RUN chmod +x install.sh
RUN ./install.sh

# Run test suite and CLI validation
CMD ["bash", "-c", "\
    set -e && \
    echo '===================================================' && \
    echo '  Experienced LLMs: Docker Container Test Pipeline' && \
    echo '===================================================' && \
    bash scripts/run_all_tests.sh && \
    echo '=== Testing CLI Shims & Intraday Logging in Container ===' && \
    ~/.local/bin/experienced-llms log 'Isolated Docker test fact' --reason 'Hermetic container verification' --category defensive_heuristic && \
    echo '=== Testing Consolidator in Container ===' && \
    ~/.local/bin/experienced-llms consolidate --prepare && \
    echo '=== Checking Master Experience in Container ===' && \
    ~/.local/bin/experienced-llms show && \
    echo '===================================================' && \
    echo '[SUCCESS] All isolated Docker container checks passed!' && \
    echo '==================================================='\
"]
